# Operator-owned desired configuration, not an installed runtime policy.
HyperReview:
  specification_status: "design"

'#scheduler':
  poll_interval_seconds: 300
  poll_scope: "PR discovery"
  queue_wake_seconds: 30
  entrypoint: "hyperreview.worker.run"
  install_enabled: false
  implemented_stage: "intake-only"
  inference_enabled: false
  publication_enabled: false

'#queue':
  concurrency: 1
  max_pending_intake_tasks: 32

'#journal':
  intake_store: "sqlite"
  max_intake_receipts: 2048

'#intake-task-policy':
  policy_library: "specification-core"
  max_collection_attempts: 2

'#request-handoff':
  stage: "request_prepared"
  delivery_mode: "request_only"

'#specgraph':
  slug: "0al-spec/SpecGraph"
  enabled: true

'#hypercode':
  slug: "0al-spec/Hypercode"
  enabled: true

'#sessionmonitor':
  slug: "SoundBlaster/SessionMonitor"
  enabled: true

'#eligibility':
  policy_library: "specification-core"
  author_login: "SoundBlaster"
  same_repository_required: true
  include_drafts: false
  include_closed: false

# Developer/CI measurement of this repository, not analyzed PR execution.
'#project-quality':
  source_scope: "hyperreview"
  execution: "developer-and-ci"
  combined_score: false

'#specificationmetrics':
  transport: "local-cli"
  hosted_classification_enabled: false

'#evidence':
  max_files: 30
  max_bytes: 262144
  execute_source: false

'#backend':
  provider: "unconfigured"
  transport: "none"
  endpoint: ""
  configured: false
  model_selection: "operator-required"
  model: ""
  reasoning_effort: ""

'#projection':
  interpretation_status: "illustrative"
  profile_version: "composition-v1"

'#hypercode-validator':
  ir_version: 2

'#preview':
  enabled: true

'#publication-gate':
  requested: false
  operator_authorization_required: true
  revision_recheck_required: true

'#publisher':
  delivery_mode: "preview"
  comment_marker_namespace: "hyperreview"

AutomaticCommentDelivery:
  enabled: false
  implementation: "hyperreview/publication_worker.py"
  max_jobs_per_tick: 1
  wake_seconds: 30
  first_delivery: "on ready preview"
  retry_interval_seconds: 300
  model_calls: 0
  publication_mode: "comment"
  ci_observations: "hyperreview/ci_observations.py"
  ci_revision: "pinned head"
  ci_required: false
  ci_read_timeout_seconds: 5
  ci_max_checks: 12
  ci_display: "collapsed supporting evidence"

StandingPublicationGrant:
  source: "operator_config"
  source_config_digest_required: true
  repository_subset_required: true

PublicationSnapshot:
  upstream_manifest_preserved: true
  tracking_confirmation_required: true

DeliveryRecovery:
  max_delivery_attempts: 3
  reuse_exact_pending_plan: true
  retained_receipt_limit: 2048

AutomaticGateLifecycle:
  enabled: false
  implementation: "hyperreview/automatic_review_gate.py"
  authority: "operator-repository-grant"
  owned_automatic_threads_only: true

ReviewStartNotice:
  before_inference: true
  started_time_required: true
  eta_seconds: 600
  eta_releases_gate: false

GateCompletion:
  committed_preview_required: true
  fresh_revision_check_required: true
  analysis_failure_keeps_open: true

PublishedReviewLink:
  implementation: "hyperreview/review_summary_link.py"
  confirmed_publication_required: true
  owned_completed_thread_only: true
  max_post_attempts: 1
  replay_inference: false

GateRecovery:
  replay_inference: false
  duplicate_creation_allowed: false
  max_reconciliations_per_tick: 1

@review_gate_stage[automatic]:
  AutomaticGateLifecycle:
    enabled: true

@publication_stage[automatic_comment]:
  AutomaticCommentDelivery:
    enabled: true

'#budget':
  analysis_timeout_seconds: 300
  max_model_attempts: 2

'#tracking':
  enabled: true
  experiment_name: "HyperReview-Pilot"
  publication_receipt_required: true

'#mlflow':
  tracking_uri: "http://127.0.0.1:5000"
  server_install_enabled: false

'#traces':
  instrumentation: "manual"
  capture_content: false

'#evaluation':
  llm_judge_enabled: false

'#evidently':
  enabled: true
  deployment: "local-library"
  cloud_upload_enabled: false

'#reports':
  capture_content: false
  format_profile: "json-html"

'#regression':
  blocking: false
  threshold_policy: "operator-required"

'#tracking-spool':
  max_events: 1000
  max_bytes: 1048576

'#audit':
  bundle_retention_days: 7
  redact_credentials: true

'#credentials':
  expose_to_model: false

'#isolation':
  source_execution_allowed: false
  model_tools_allowed: false
  capability_verification_required: true

@backend[codex]:
  '#backend':
    provider: "codex"
    transport: "codex-exec"
    configured: true
    model_selection: "pilot-default"
    model: "gpt-6-luna"
    reasoning_effort: "low"

@backend[lmstudio]:
  '#backend':
    provider: "lmstudio"
    transport: "http-inference"
    endpoint: "http://127.0.0.1:1234/v1"
    configured: true

@backend[ollama]:
  '#backend':
    provider: "ollama"
    transport: "http-inference"
    endpoint: "http://127.0.0.1:11434/api"
    configured: true

@mode[publish]:
  '#publisher':
    delivery_mode: "publish"
  '#publication-gate':
    requested: true

# Applicable in every context. These constrain values, not worker behavior.
@contract:
  '#scheduler':
    poll_interval_seconds: int >= 300 <= 86400
    install_enabled: bool
    implemented_stage: string
    inference_enabled: bool
    publication_enabled: bool
  '#queue':
    concurrency: int >= 1 <= 1
    max_pending_intake_tasks: int >= 1 <= 32
  '#journal':
    intake_store: string
    max_intake_receipts: int >= 1 <= 2048
  '#intake-task-policy':
    policy_library: string
    max_collection_attempts: int >= 1 <= 2
  '#request-handoff':
    stage: string
    delivery_mode: string
  Repository:
    slug: string
    enabled: bool
  '#eligibility':
    author_login: string
    same_repository_required: bool
    include_drafts: bool
    include_closed: bool
  '#evidence':
    max_files: int >= 1 <= 100
    max_bytes: int >= 1 <= 1048576
    execute_source: bool
  '#backend':
    provider: string
    transport: string
    endpoint: string
    configured: bool
    model_selection: string
    model: string
    reasoning_effort: string
  '#hypercode-validator':
    ir_version: int >= 2 <= 2
  '#publication-gate':
    requested: bool
    operator_authorization_required: bool
    revision_recheck_required: bool
  '#budget':
    analysis_timeout_seconds: int >= 1 <= 600
    max_model_attempts: int >= 1 <= 2
  '#audit':
    bundle_retention_days: int >= 1 <= 30
    redact_credentials: bool
  '#tracking':
    enabled: bool
    experiment_name: string
    publication_receipt_required: bool
  '#mlflow':
    tracking_uri: string
    server_install_enabled: bool
  '#traces':
    instrumentation: string
    capture_content: bool
  '#evaluation':
    llm_judge_enabled: bool
  '#evidently':
    enabled: bool
    deployment: string
    cloud_upload_enabled: bool
  '#reports':
    capture_content: bool
    format_profile: string
  '#regression':
    blocking: bool
    threshold_policy: string
  '#tracking-spool':
    max_events: int >= 1 <= 1000
    max_bytes: int >= 1 <= 1048576
  '#credentials':
    expose_to_model: bool
  '#isolation':
    source_execution_allowed: bool
    model_tools_allowed: bool
    capability_verification_required: bool

# Private-preview execution is an explicit v2 config, independent of publication.
PrivatePreviewJobs:
  enabled: false
  implementation: "hyperreview/worker_preview.py"
  max_jobs_per_tick: 1
  max_jobs_per_run: 1
  intake_continuation: "same invocation"
  replay_failed: false
  output: "private-preview"

PreviewJournal:
  implementation: "hyperreview/worker_preview.py"
  store: "sqlite"

PreviewHandoff:
  implementation: "hyperreview/worker_generation.py"
  tracking_status: "not_started"
  github_writes: 0

@worker_stage[private_preview]:
  '#scheduler':
    implemented_stage: "private-preview"
    inference_enabled: true
  PrivatePreviewJobs:
    enabled: true

@contract:
  PrivatePreviewJobs:
    enabled: bool
    implementation: string
    max_jobs_per_tick: int >= 1 <= 1
    replay_failed: bool
    output: string
  PreviewHandoff:
    tracking_status: string
    github_writes: int >= 0 <= 0
